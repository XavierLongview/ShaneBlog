---
import { withBase } from '../lib/url';

interface Props {
  current?: 'essays' | 'projects' | 'about';
}
const { current } = Astro.props;

// Projects and About are still placeholder pages (no real content yet) —
// left unlinked here on purpose. Add them back once they're written.
const items = [
  { label: 'Essays', href: withBase('/'), key: 'essays' },
  { label: 'RSS', href: withBase('/rss.xml'), key: 'rss' },
];
---
<nav class="banner">
  {items.map((item) => (
    <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>
      {item.label}
    </a>
  ))}
</nav>
