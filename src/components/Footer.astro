---
import { SITE } from '../config';
import { withBase } from '../lib/url';
---
<footer class="site">
  <div class="inner">
    <div class="slogan"><span class="star">★</span> {SITE.slogan} <span class="star">★</span></div>
    <div class="colophon-row">
      <div class="links">
        <a href={withBase('/rss.xml')}>RSS</a> ·
        <a href={`mailto:${SITE.email}`}>EMAIL</a> ·
        <a href={SITE.github}>GITHUB</a>
        {SITE.relay !== '#' && <> · <a href={SITE.relay}>RELAY</a></>}
      </div>
    </div>
  </div>
</footer>
