---
import { SITE } from '../config';
import { withBase } from '../lib/url';
---
<footer class="site">
  <div class="inner">
    <div class="slogan"><span class="star">★</span> {SITE.slogan} <span class="star">★</span></div>
    <div class="colophon-row">
      <p>
        Set in Archivo Black, Source Serif, and IBM Plex Mono on poster cream.
        The mark is five arrows in a shared loop — no single line draws the star;
        it appears between them and lasts only while the loop turns.
        Design and code: a human steering a machine. The words: human only.
        No cookies, no ads, no algorithm — just RSS and a URL.
      </p>
      <div class="links">
        <a href={withBase('/rss.xml')}>RSS</a> ·
        <a href={`mailto:${SITE.email}`}>EMAIL</a> ·
        <a href={SITE.github}>GITHUB</a> ·
        <a href={SITE.relay}>RELAY</a>
      </div>
    </div>
  </div>
</footer>
